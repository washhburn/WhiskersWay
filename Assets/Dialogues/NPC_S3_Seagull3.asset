  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14b9290989b12e140b708c940b05caca, type: 3}
  m_Name: NPC_S3_Seagull3
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Seagull Sarah
  beforeQuest:
  - text: '*Squeeaaaak*'
    autoProgress: 1
  - text: Hello kitty-cat! I am a bit busy here, but maybe you could help me out?
    autoProgress: 0
  - text: I am collecting berries for my friend, who is on another island.
    autoProgress: 0
  - text: We love to eat blueberries, and you can find the sweetest ones here!
    autoProgress: 0
  - text: Could you collect 5 berries for me, and bring them to my friend on the
      South-East island?
    autoProgress: 0
  duringQuest:
  - text: Did you find all the berries yet?
    autoProgress: 0
  - text: Once you've found all of them, bring them to my friend on SouthEast island!
    autoProgress: 0
  afterQuest:
  - text: Well done, kitty-cat! I will now collect my own berries and be on my way.
      Good day to you!
    autoProgress: 0
  autoProgressDelay: 1
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
