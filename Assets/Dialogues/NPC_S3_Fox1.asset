  m_Script: {fileID: 11500000, guid: 14b9290989b12e140b708c940b05caca, type: 3}
  m_Name: NPC_S3_Fox1
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Fox Ruby
  beforeQuest:
  - text: '*Cough*'
    autoProgress: 1
  - text: Oh, I'm sorry for coughing at you. I am a bit ill at the moment.
    autoProgress: 0
  duringQuest:
  - text: '*Cough*'
    autoProgress: 1
  - text: Did you speak to my husband about the snakes? Oh... Yes, I am unwell right
      now.
    autoProgress: 0
  - text: I would have to drink some medicine to get better, but we've been attacked
      by the snakes and a large cobra recently.
    autoProgress: 0
  - text: My husband got hurt and cannot move further than our yard.
    autoProgress: 0
  - text: Could you help me collect 3 herbs and bring them back? The herbs look like
      white flowers and grow on one of the Eastern islands.
    autoProgress: 0
  afterQuest:
  - text: Thank you! Oh, that was so kind of you!
    autoProgress: 0
  - text: I wlll now brew my healing concoction so I can get well again.
    autoProgress: 0
  - text: Here, take this as a reward for your good deed!
    autoProgress: 0
  - text: '*You were given a quest item!* '
    autoProgress: 0
  autoProgressDelay: 1
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
