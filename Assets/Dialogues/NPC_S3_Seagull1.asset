  npcName: Seagull Seamus
  beforeQuest:
  - text: '*Squeeaaaak*'
    autoProgress: 1
  - text: 'This town is surrounded by snakes these days. I cannot reach the other
      islands, where my friend is! '
    autoProgress: 0
  - text: Could you help me clear the path?
    autoProgress: 0
  duringQuest:
  - text: Did you kill the snakes yet? I need to reach my friend!
    autoProgress: 0
  afterQuest:
  - text: Thank you, my friend! Now I can finally continue on my journey, thanks
      to you.
    autoProgress: 0
  - text: You can take this as payment, friend!
    autoProgress: 0
  - text: '*You were given a quest item!* '
    autoProgress: 0
