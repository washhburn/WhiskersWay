  npcName: Mouse Miles
  beforeQuest:
  - text: Argghhh a cat!!
    autoProgress: 1
  - text: Oh, you're not going to eat me?
    autoProgress: 0
  - text: 'Hrm, sorry about that. '
    autoProgress: 0
  duringQuest:
  - text: 'Still not hungry? Hehe, good cat. '
    autoProgress: 0
  - text: Oh, you're looking for Calvin? I heard he wanted to go on an adventure
      in the forest next to town.
    autoProgress: 0
  - text: I believe it's the forest to the East.
    autoProgress: 0
  afterQuest:
  - text: Good job finding Calvin, kitty. I heard he was in some trouble out there.
    autoProgress: 0
