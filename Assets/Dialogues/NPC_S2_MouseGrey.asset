  m_Name: NPC_S2_MouseGrey
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Mouse May
  beforeQuest:
  - text: You're a cat!! Don't eat me!!
    autoProgress: 1
  - text: ... You're not going to eat anyone here?
    autoProgress: 0
  - text: Oh, you should have said so from the beginning.
    autoProgress: 0
  duringQuest:
  - text: You're looking for Calvin? He was here this morning, he spoke to my siblings
      about going on an adventure.
    autoProgress: 0
  - text: Maybe you can ask them for some information. They're inside the house.
    autoProgress: 0
  afterQuest:
  - text: Ohh, you're a hero cat! Thank you for finding Calvin and saving him from
      the snakes!
    autoProgress: 0
  autoProgressDelay: 1
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
